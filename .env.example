# Copy this file to .env and fill in your Neon (or other Postgres) connection
# string. .env is gitignored - never commit real credentials.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Signs the login session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# LOCAL DEVELOPMENT ONLY - skips the login screen and the payroll PIN.
# Set it to a display name or staff name, e.g. DEV_AUTO_LOGIN=Jomark.
# Ignored unless the app is running in debug on this machine, and it must
# never be set as a Fly secret. Leave it blank or delete the line to get
# the normal login back.
DEV_AUTO_LOGIN=
